# CareVoice settings. Copy this file to .env and fill it in:   copy .env.example .env
# .env is read by docker compose, and by the PowerShell scripts in scripts\ for a run without Docker.
# Never commit .env. Never share one .env between environments: each environment makes its own VOICE_MASTER_KEYS.

# ────────────────────────── Gemini Live (the worker) ──────────────────────────
# A Gemini Developer API key (Google AI Studio). Required for any call: Gemini hears and thinks.
GOOGLE_API_KEY=

# The Gemini Live model and its own voice.
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_LIVE_VOICE=Kore

# ────────────────────────── Mistral (the cloned voice only) ──────────────────────────
# Used by the API, only to clone a voice and to speak with it. Without it the demo still works: Gemini speaks with its
# own voice, and the Voices screen tells you cloning is off. The worker never receives this key.
MISTRAL_API_KEY=

# Mistral's address and speech model. For EU-hosted speech use https://api.eu.mistral.ai (check the account allows it).
# TTS_API_BASE=https://api.mistral.ai
# TTS_MODEL=voxtral-mini-tts-3

# How a cloned voice sounds. A clone copies the delivery of its recording, so a flat recording gives a flat voice.
# TTS_CLONE_EXPRESSIVENESS: 1.0 to 5.0, higher is livelier but less like the speaker; 0 sends none.
# TTS_CLONE_PACE: very-slow, slow, moderate, fast, very-fast; set it empty (TTS_CLONE_PACE=) to send none.
#                 Mistral documents the pace tag for English only.
# TTS_CLONE_EXPRESSIVENESS=3.0
# TTS_CLONE_PACE=moderate

# ────────────────────────── The vault (encrypted recordings) ──────────────────────────
# Every recording a voice was made from is kept encrypted (AES-256-GCM, a key per recording), locked by this master
# key, so a voice Mistral loses can be made again. Format: id:base64 32-byte key, comma separated, newest first.
# Make it with:   python -m api.make_master_key .env      (it never prints the key)
# Rotate with:    python -m api.make_master_key .env --rotate     then run:  python -m api.care
# Without a master key no voice can be cloned (nothing could be kept).
VOICE_MASTER_KEYS=

# Signs the call's speech grant (the worker's pass to have the cloned voice speak). Any long random text. If empty,
# the LiveKit secret below is used.
DEMO_SECRET=

# The nightly care: checks every voice at Mistral, makes lost ones again, retries deletes, renews Mistral's retention,
# locks recordings with the newest master key.
# VOICE_CARE_AT=00:00
# VOICE_CARE_TIMEZONE=Europe/Brussels
# TTS_MAX_CHARS=4000

# ────────────────────────── LiveKit ──────────────────────────
# These two must match docker/livekit.yaml. The defaults are development keys: change both files for anything real.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=carevoice-local-livekit-secret-change-me-please

# Only for a run WITHOUT Docker for the API and the worker (scripts\run-api.ps1, scripts\run-worker.ps1).
# docker compose sets these itself; leave them as they are.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
DEMO_API_URL=http://localhost:8000
DEMO_DB_PATH=./data/demo.sqlite3
